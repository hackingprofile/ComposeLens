# Operator files: local env files, generated reports, CI artifacts and support
# bundles can hold real project values; keep them out of commits.
.env
.env.*
*.env
report.html
report.json
composelens-report.*
composelens-support*.json
composelens-check.*
composelens-annotations.txt

# Public lab, example, fixture and golden data is synthetic and stays tracked.
!/examples/**/.env
!/examples/**/.env.*
!/examples/**/*.env
!/fixtures/**/.env
!/fixtures/**/.env.*
!/fixtures/**/*.env
!/testdata/**
